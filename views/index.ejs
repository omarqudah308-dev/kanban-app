<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kanban App</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 font-sans">
    <div class="container mx-auto p-4">
        <h1 class="text-3xl font-bold text-center mb-8">Kanban Micro-SaaS</h1>
        <div class="flex flex-wrap -mx-2">
            <div class="w-full md:w-1/3 px-2 mb-4">
                <div class="bg-white p-4 rounded shadow">
                    <h2 class="text-xl font-bold mb-4">To Do</h2>
                    <ul id="todo-list" class="min-h-[100px] border-2 border-dashed border-gray-200 p-2 rounded">
                    </ul>
                </div>
            </div>
            <!-- More columns will be added here -->
        </div>
        <button id="checkout-button" class="mt-8 bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded block mx-auto">
            Upgrade to Premium
        </button>
    </div>
    <script src="https://js.stripe.com/v3/"></script>
    <script>
        const stripe = Stripe('your-publishable-key-here');
        document.getElementById('checkout-button').addEventListener('click', async () => {
            const response = await fetch('/create-checkout-session', { method: 'POST' });
            const session = await response.json();
            stripe.redirectToCheckout({ sessionId: session.id });
        });
    </script>
</body>
</html>
