<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment Canceled — Kanban App</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/app.css">
</head>
<body>
    <div class="app">
        <aside class="sidebar">
            <div class="brand">
                <div class="brand-mark">◈</div>
                <div class="brand-text">
                    <div class="brand-name">Kanban</div>
                    <div class="brand-sub">Premium</div>
                </div>
            </div>
        </aside>
        <main class="main">
            <div class="empty-state">
                <div class="empty-emoji">✕</div>
                <h1 class="board-title">Checkout canceled</h1>
                <p class="board-sub">No charge was made. Your board is still on the Free plan.</p>
                <a class="btn-primary" href="/">Back to board</a>
            </div>
        </main>
    </div>
</body>
</html>